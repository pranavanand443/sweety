{
  "name": "sweety", "version": "1.0.0", "private": true, "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js", "dev:client": "vite --host 127.0.0.1",
    "build": "vite build", "start": "node server/index.js",
    "db:migrate": "node server/migrate.js", "db:seed": "node server/seed.js",
    "test": "vitest run", "test:unit": "vitest run tests/shared.test.js tests/ReadingForm.test.jsx",
    "test:api": "vitest run tests/api.test.js", "lint": "eslint .",
    "verify": "npm run lint && npm test && npm run build"
  }
}
