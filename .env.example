# Local Docker database; these are disposable demo credentials only.
DATABASE_URL=postgresql://sweety:sweety_local@localhost:54329/sweety
TEST_DATABASE_URL=postgresql://sweety:sweety_local@localhost:54329/sweety_test
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
# false for the local HTTP demo, true when deploying behind HTTPS.
COOKIE_SECURE=false
NODE_ENV=development
# Optional reproducible seed reference date (YYYY-MM-DD); defaults to today.
# SEED_DATE=2026-11-15
